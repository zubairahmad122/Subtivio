{
  "name": "subtivio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @subtivio/mobile start",
    "web": "pnpm --filter @subtivio/mobile web",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "android": "pnpm --filter @subtivio/mobile android",
    "ios": "pnpm --filter @subtivio/mobile ios",
    "build:apk": "pnpm --filter @subtivio/mobile build:apk",
    "install:apk": "pnpm --filter @subtivio/mobile install:apk",
    "server": "pnpm --filter @subtivio/server dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
