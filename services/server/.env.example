# Copy to .env. Without keys the server still runs, using a demo transcript.

# Speech to text with word timings. AssemblyAI is used first (most accurate
# timing; free credit on signup at assemblyai.com). If it fails or is not set,
# Gemini transcribes instead.
ASSEMBLYAI_API_KEY=

# Gemini free tier (aistudio.google.com/apikey): Roman/Urdu/Hindi conversion,
# and transcription backup. The server finds the free Flash models for your key
# and switches to the next one automatically when a model hits its quota.
# Free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
# Transcription starts on the newest Flash model, script conversion on Flash-Lite.
# Optional: model to try first, or a fixed comma-separated list.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Estimated free requests per day per model. Google does not report the real
# quota (see aistudio.google.com); the server switches model when it reaches
# these counts or when Google answers 429. Usage resets at midnight Pacific.
# GEMINI_FLASH_DAILY_LIMIT=1500
# GEMINI_LITE_DAILY_LIMIT=1000

# Optional: Claude instead of Gemini for script conversion (used if set).
ANTHROPIC_API_KEY=
TRANSLIT_MODEL=claude-haiku-5-5

PORT=8787
DATA_DIR=./data
# ffmpeg 7+ with libass. Ubuntu 24.04's ffmpeg 6.1 draws Nastaliq as empty boxes;
# point these at a newer static build if your distro's is older.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
