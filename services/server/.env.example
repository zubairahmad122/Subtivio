# Copy to .env. Without keys the server still runs, using a demo transcript.

# Speech to text with word timings (free credit on signup: assemblyai.com).
ASSEMBLYAI_API_KEY=

# Roman/Urdu/Hindi conversion: set ONE of these. Claude is used if both are set.
# Gemini has a free tier (aistudio.google.com/apikey); free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
TRANSLIT_MODEL=claude-haiku-5-5
PORT=8787
DATA_DIR=./data
# ffmpeg 7+ with libass. Ubuntu 24.04's ffmpeg 6.1 draws Nastaliq as empty boxes;
# point these at a newer static build if your distro's is older.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
